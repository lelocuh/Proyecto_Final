    "class LibroService:\n",
    "    \"\"\"Reglas de negocio para libros y categorías (RF-02).\"\"\"\n",
    "\n",
    "    def __init__(self, libro_repo, categoria_repo):\n",
    "        self.libro_repo = libro_repo\n",
    "        self.categoria_repo = categoria_repo\n",
    "\n",
    "    def registrar(self, isbn, titulo, autor, cod_categoria, anio, total_ejemplares):\n",
    "        \"\"\"Registra un libro nuevo con todos sus ejemplares disponibles.\"\"\"\n",
    "        if self.libro_repo.find_by_isbn(isbn):\n",
    "            raise ValueError('Ya existe un libro con ese ISBN.')\n",
    "        if self.categoria_repo.find_by_codigo(cod_categoria) is None:\n",
    "            raise ValueError('La categoría indicada no existe.')\n",
    "        if total_ejemplares < 1:\n",
    "            raise ValueError('El número de ejemplares debe ser al menos 1.')\n",
    "        libro = Libro(isbn, titulo, autor, cod_categoria, anio,\n",
    "                      total_ejemplares, total_ejemplares)\n",
    "        self.libro_repo.guardar(libro)\n",
    "        return libro\n",
    "\n",
    "    def registrar_categoria(self, codigo, nombre, descripcion):\n",
    "        \"\"\"Registra una categoría nueva.\"\"\"\n",
    "        if self.categoria_repo.find_by_codigo(codigo):\n",
    "            raise ValueError('Ya existe una categoría con ese código.')\n",
    "        c = Categoria(codigo, nombre, descripcion)\n",
    "        self.categoria_repo.guardar(c)\n",
    "        return c\n",
    "\n",
    "    def buscar_por_isbn(self, isbn):\n",
    "        \"\"\"Retorna el libro con ese ISBN, o None.\"\"\"\n",
    "        return self.libro_repo.find_by_isbn(isbn)\n",
    "\n",
    "    def buscar_por_titulo(self, txt):\n",
    "        \"\"\"Retorna los libros cuyo título contiene txt.\"\"\"\n",
    "        return self.libro_repo.find_by_titulo(txt)\n",
    "\n",
    "    def listar_por_categoria(self, cod):\n",
    "        \"\"\"Retorna los libros de una categoría.\"\"\"\n",
    "        return self.libro_repo.find_by_categoria(cod)\n",
    "\n",
    "    def listar_categorias(self):\n",
    "        \"\"\"Retorna todas las categorías.\"\"\"\n",
    "        return self.categoria_repo.find_all()\n",
    "\n",
    "    def listar_todos(self):\n",
    "        \"\"\"Retorna todos los libros del catálogo.\"\"\"\n",
    "        return self.libro_repo.find_all()\n",
    "\n",
    "    def listar_disponibles(self):\n",
    "        \"\"\"Retorna los libros con al menos un ejemplar disponible.\"\"\"\n",
    "        return [l for l in self.libro_repo.find_all() if l.disponibles > 0]"
