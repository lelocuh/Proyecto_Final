    "### Celda 4.0: servicios y funciones auxiliares"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Instancias de los servicios que usa la interfaz\n",
    "usuario_service = UsuarioService(UsuarioRepository())\n",
    "libro_service = LibroService(LibroRepository(), CategoriaRepository())\n",
    "prestamo_service = PrestamoService(PrestamoRepository(), LibroRepository(),\n",
    "                                   UsuarioRepository())\n",
    "\n",
    "H_USUARIOS = ['Documento', 'Nombre', 'Tipo', 'Correo', 'Teléfono', 'Estado']\n",
    "H_CATEGORIAS = ['Código', 'Nombre', 'Descripción']\n",
    "H_LIBROS = ['ISBN', 'Título', 'Autor', 'Categoría', 'Año', 'Disponibles', 'Total']\n",
    "H_PRESTAMOS = ['Código', 'ISBN', 'Documento', 'Fecha préstamo', 'Fecha límite',\n",
    "               'Fecha devolución', 'Estado']\n",
    "\n",
    "\n",
    "def _tabla(filas, columnas):\n",
    "    \"\"\"Retorna las filas, o una fila vacía si no hay resultados.\"\"\"\n",
    "    return filas if filas else [[''] * len(columnas)]\n",
    "\n",
    "\n",
    "def usuarios_a_filas(usuarios):\n",
    "    \"\"\"Convierte una lista de Usuario en filas para la tabla.\"\"\"\n",
    "    return [[u.num_documento, u.nombre, u.tipo.value, u.correo, u.telefono, u.estado]\n",
    "            for u in usuarios]\n",
    "\n",
    "\n",
    "def categorias_a_filas(categorias):\n",
    "    \"\"\"Convierte una lista de Categoria en filas para la tabla.\"\"\"\n",
    "    return [[c.codigo, c.nombre, c.descripcion] for c in categorias]\n",
    "\n",
    "\n",
    "def libros_a_filas(libros):\n",
    "    \"\"\"Convierte una lista de Libro en filas para la tabla.\"\"\"\n",
    "    return [[l.isbn, l.titulo, l.autor, l.cod_categoria, l.anio,\n",
    "             l.disponibles, l.total_ejemplares] for l in libros]\n",
    "\n",
    "\n",
    "def prestamos_a_filas(prestamos):\n",
    "    \"\"\"Convierte una lista de Prestamo en filas para la tabla.\"\"\"\n",
    "    return [[p.codigo, p.isbn, p.num_documento, p.fecha_prestamo, p.fecha_limite,\n",
    "             p.fecha_devolucion, p.estado.value] for p in prestamos]\n",
    "\n",
    "\n",
    "def _texto(valor, nombre):\n",
    "    \"\"\"Valida un texto obligatorio que no contenga el carácter |.\"\"\"\n",
    "    v = (valor or '').strip()\n",
    "    if not v:\n",
    "        raise ValueError(f'El campo {nombre} es obligatorio.')\n",
    "    if '|' in v:\n",
    "        raise ValueError(f'El campo {nombre} no puede contener el carácter |.')\n",
    "    return v\n",
    "\n",
    "\n",
    "def _texto_opcional(valor, nombre):\n",
    "    \"\"\"Valida un texto opcional que no contenga el carácter |.\"\"\"\n",
    "    v = (valor or '').strip()\n",
    "    if '|' in v:\n",
    "        raise ValueError(f'El campo {nombre} no puede contener el carácter |.')\n",
    "    return v\n",
    "\n",
    "\n",
    "def _entero(valor, nombre, minimo=None):\n",
    "    \"\"\"Convierte un valor numérico de la interfaz en entero.\"\"\"\n",
    "    if valor is None or valor == '':\n",
    "        raise ValueError(f'El campo {nombre} es obligatorio.')\n",
    "    try:\n",
    "        n = int(valor)\n",
    "    except (TypeError, ValueError):\n",
    "        raise ValueError(f'El campo {nombre} debe ser un número entero.')\n",
    "    if minimo is not None and n < minimo:\n",
    "        raise ValueError(f'El campo {nombre} debe ser al menos {minimo}.')\n",
    "    return n\n",
    "\n",
    "\n",
    "def _fecha(valor, nombre):\n",
    "    \"\"\"Convierte AAAA-MM-DD a date. Un texto vacío retorna None (se usa hoy).\"\"\"\n",
    "    v = (valor or '').strip()\n",
    "    if not v:\n",
    "        return None\n",
    "    try:\n",
    "        return datetime.strptime(v, FORMATO_FECHA).date()\n",
    "    except ValueError:\n",
    "        raise ValueError(f'{nombre} inválida. Use el formato AAAA-MM-DD.')"
   ]
