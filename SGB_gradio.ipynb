    "## Sección 2: repositorios (persistencia)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Celda 2.1: ArchivoUtil"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "class ArchivoUtil:\n",
    "    \"\"\"Lectura y escritura de archivos de texto (un registro por línea).\"\"\"\n",
    "\n",
    "    @staticmethod\n",
    "    def leer_lineas(ruta):\n",
    "        \"\"\"Lee todas las líneas de un archivo. Retorna lista vacía si no existe.\"\"\"\n",
    "        try:\n",
    "            with open(ruta, 'r', encoding='utf-8') as f:\n",
    "                return [l.strip() for l in f if l.strip()]\n",
    "        except FileNotFoundError:\n",
    "            return []\n",
    "\n",
    "    @staticmethod\n",
    "    def escribir_linea(ruta, linea):\n",
    "        \"\"\"Agrega una línea al final del archivo.\"\"\"\n",
    "        with open(ruta, 'a', encoding='utf-8') as f:\n",
    "            f.write(linea + '\\n')\n",
    "\n",
    "    @staticmethod\n",
    "    def reescribir(ruta, lineas):\n",
    "        \"\"\"Reemplaza el contenido completo del archivo.\"\"\"\n",
    "        with open(ruta, 'w', encoding='utf-8') as f:\n",
    "            f.write('\\n'.join(lineas) + ('\\n' if lineas else ''))\n",
    "\n",
    "    @staticmethod\n",
    "    def generar_codigo(prefijo):\n",
    "        \"\"\"Genera un código único basado en timestamp.\"\"\"\n",
    "        ts = datetime.now().strftime('%Y%m%d%H%M%S%f')[:20]\n",
    "        return f'{prefijo}-{ts}'\n",
    "\n",
    "    @staticmethod\n",
    "    def reemplazar_linea(ruta, clave, nueva_linea):\n",
    "        \"\"\"Reemplaza la línea cuyo primer campo es clave. Retorna True si la encontró.\"\"\"\n",
    "        lineas = ArchivoUtil.leer_lineas(ruta)\n",
    "        encontrada = False\n",
    "        for i, l in enumerate(lineas):\n",
    "            if l.split('|')[0] == clave:\n",
    "                lineas[i] = nueva_linea\n",
    "                encontrada = True\n",
    "                break\n",
    "        if encontrada:\n",
    "            ArchivoUtil.reescribir(ruta, lineas)\n",
    "        return encontrada"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Celda 2.2: UsuarioRepository"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "class UsuarioRepository:\n",
    "    \"\"\"Persistencia de usuarios en usuarios.txt.\"\"\"\n",
    "\n",
    "    def __init__(self, ruta=RUTA_USUARIOS):\n",
    "        self.ruta = ruta\n",
    "\n",
    "    def guardar(self, u):\n",
    "        \"\"\"Agrega un usuario al archivo.\"\"\"\n",
    "        ArchivoUtil.escribir_linea(self.ruta, u.to_linea())\n",
    "\n",
    "    def find_by_documento(self, doc):\n",
    "        \"\"\"Retorna el Usuario con ese documento, o None.\"\"\"\n",
    "        for l in ArchivoUtil.leer_lineas(self.ruta):\n",
    "            if l.split('|')[0] == doc:\n",
    "                return Usuario.from_linea(l)\n",
    "        return None\n",
    "\n",
    "    def find_all(self):\n",
    "        \"\"\"Retorna la lista de todos los usuarios.\"\"\"\n",
    "        return [Usuario.from_linea(l) for l in ArchivoUtil.leer_lineas(self.ruta)]\n",
    "\n",
    "    def actualizar(self, u):\n",
    "        \"\"\"Reemplaza en el archivo el registro del usuario.\"\"\"\n",
    "        return ArchivoUtil.reemplazar_linea(self.ruta, u.num_documento, u.to_linea())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Celda 2.3: CategoriaRepository"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "class CategoriaRepository:\n",
    "    \"\"\"Persistencia de categorías en categorias.txt.\"\"\"\n",
    "\n",
    "    def __init__(self, ruta=RUTA_CATEGORIAS):\n",
    "        self.ruta = ruta\n",
    "\n",
    "    def guardar(self, c):\n",
    "        \"\"\"Agrega una categoría al archivo.\"\"\"\n",
    "        ArchivoUtil.escribir_linea(self.ruta, c.to_linea())\n",
    "\n",
    "    def find_by_codigo(self, cod):\n",
    "        \"\"\"Retorna la Categoria con ese código, o None.\"\"\"\n",
    "        for l in ArchivoUtil.leer_lineas(self.ruta):\n",
    "            if l.split('|')[0] == cod:\n",
    "                return Categoria.from_linea(l)\n",
    "        return None\n",
    "\n",
    "    def find_all(self):\n",
    "        \"\"\"Retorna la lista de todas las categorías.\"\"\"\n",
    "        return [Categoria.from_linea(l) for l in ArchivoUtil.leer_lineas(self.ruta)]"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Celda 2.4: LibroRepository"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "class LibroRepository:\n",
    "    \"\"\"Persistencia de libros en libros.txt.\"\"\"\n",
    "\n",
    "    def __init__(self, ruta=RUTA_LIBROS):\n",
    "        self.ruta = ruta\n",
    "\n",
    "    def guardar(self, l):\n",
    "        \"\"\"Agrega un libro al archivo.\"\"\"\n",
    "        ArchivoUtil.escribir_linea(self.ruta, l.to_linea())\n",
    "\n",
    "    def find_by_isbn(self, isbn):\n",
    "        \"\"\"Retorna el Libro con ese ISBN, o None.\"\"\"\n",
    "        for linea in ArchivoUtil.leer_lineas(self.ruta):\n",
    "            if linea.split('|')[0] == isbn:\n",
    "                return Libro.from_linea(linea)\n",
    "        return None\n",
    "\n",
    "    def find_by_titulo(self, txt):\n",
    "        \"\"\"Retorna los libros cuyo título contiene txt (sin distinguir mayúsculas).\"\"\"\n",
    "        txt = txt.lower()\n",
    "        return [l for l in self.find_all() if txt in l.titulo.lower()]\n",
    "\n",
    "    def find_by_categoria(self, cod):\n",
    "        \"\"\"Retorna los libros de una categoría.\"\"\"\n",
    "        return [l for l in self.find_all() if l.cod_categoria == cod]\n",
    "\n",
    "    def find_all(self):\n",
    "        \"\"\"Retorna la lista de todos los libros.\"\"\"\n",
    "        return [Libro.from_linea(l) for l in ArchivoUtil.leer_lineas(self.ruta)]\n",
    "\n",
    "    def actualizar(self, l):\n",
    "        \"\"\"Reemplaza en el archivo el registro del libro.\"\"\"\n",
    "        return ArchivoUtil.reemplazar_linea(self.ruta, l.isbn, l.to_linea())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Celda 2.5: PrestamoRepository"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "class PrestamoRepository:\n",
    "    \"\"\"Persistencia de préstamos en prestamos.txt.\"\"\"\n",
    "\n",
    "    def __init__(self, ruta=RUTA_PRESTAMOS):\n",
    "        self.ruta = ruta\n",
    "\n",
    "    def guardar(self, p):\n",
    "        \"\"\"Agrega un préstamo al archivo.\"\"\"\n",
    "        ArchivoUtil.escribir_linea(self.ruta, p.to_linea())\n",
    "\n",
    "    def find_by_codigo(self, cod):\n",
    "        \"\"\"Retorna el Prestamo con ese código, o None.\"\"\"\n",
    "        for l in ArchivoUtil.leer_lineas(self.ruta):\n",
    "            if l.split('|')[0] == cod:\n",
    "                return Prestamo.from_linea(l)\n",
    "        return None\n",
    "\n",
    "    def find_all(self):\n",
    "        \"\"\"Retorna la lista de todos los préstamos.\"\"\"\n",
    "        return [Prestamo.from_linea(l) for l in ArchivoUtil.leer_lineas(self.ruta)]\n",
    "\n",
    "    def find_by_usuario(self, doc):\n",
    "        \"\"\"Retorna los préstamos de un usuario.\"\"\"\n",
    "        return [p for p in self.find_all() if p.num_documento == doc]\n",
    "\n",
    "    def find_by_libro(self, isbn):\n",
    "        \"\"\"Retorna los préstamos de un libro.\"\"\"\n",
    "        return [p for p in self.find_all() if p.isbn == isbn]\n",
    "\n",
    "    def actualizar(self, p):\n",
    "        \"\"\"Reemplaza en el archivo el registro del préstamo.\"\"\"\n",
    "        return ArchivoUtil.reemplazar_linea(self.ruta, p.codigo, p.to_linea())"
   ]
