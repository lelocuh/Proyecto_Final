   "source": [
    "class PrestamoService:\n",
    "    \"\"\"Reglas de negocio para préstamos y devoluciones (RF-03).\n",
    "\n",
    "    multa_repo es opcional: cuando exista MultaRepository (P3) se pasa aquí\n",
    "    para validar que el usuario no tenga multas pendientes.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, prestamo_repo, libro_repo, usuario_repo, multa_repo=None):\n",
    "        self.prestamo_repo = prestamo_repo\n",
    "        self.libro_repo = libro_repo\n",
    "        self.usuario_repo = usuario_repo\n",
    "        self.multa_repo = multa_repo\n",
    "\n",
    "    def prestar(self, num_documento, isbn, fecha_prestamo=None):\n",
    "        \"\"\"Registra un préstamo validando usuario, cupo y disponibilidad.\"\"\"\n",
    "        hoy = fecha_prestamo or date.today()\n",
    "        usuario = self.usuario_repo.find_by_documento(num_documento)\n",
    "        if usuario is None:\n",
    "            raise ValueError('El usuario no existe.')\n",
    "        if usuario.estado != ESTADO_USUARIO_ACTIVO:\n",
    "            raise ValueError('El usuario no está activo.')\n",
    "        if self.multa_repo is not None and self._tiene_multas_pendientes(num_documento):\n",
    "            raise ValueError('El usuario tiene multas pendientes.')\n",
    "\n",
    "        abiertos = [p for p in self.prestamo_repo.find_by_usuario(num_documento)\n",
    "                    if p.estado != EstadoPrestamoEnum.DEVUELTO]\n",
    "        if len(abiertos) >= CUPO_LIBROS[usuario.tipo]:\n",
    "            raise ValueError(f'El usuario alcanzó su cupo de {CUPO_LIBROS[usuario.tipo]} libros.')\n",
    "\n",
    "        libro = self.libro_repo.find_by_isbn(isbn)\n",
    "        if libro is None:\n",
    "            raise ValueError('El libro no existe.')\n",
    "        if libro.disponibles < 1:\n",
    "            raise ValueError('No hay ejemplares disponibles de este libro.')\n",
    "\n",
    "        limite = hoy + timedelta(days=DIAS_PRESTAMO[usuario.tipo])\n",
    "        prestamo = Prestamo(ArchivoUtil.generar_codigo('PRE'), isbn, num_documento,\n",
    "                            hoy.strftime(FORMATO_FECHA), limite.strftime(FORMATO_FECHA))\n",
    "        self.prestamo_repo.guardar(prestamo)\n",
    "        libro.disponibles -= 1\n",
    "        self.libro_repo.actualizar(libro)\n",
    "        return prestamo\n",
    "\n",
    "    def devolver(self, codigo, fecha_devolucion=None):\n",
    "        \"\"\"Registra la devolución y actualiza la disponibilidad del libro.\n",
    "\n",
    "        Retorna (prestamo, dias_retraso). dias_retraso será usado por\n",
    "        MultaService en P3 para calcular la multa.\n",
    "        \"\"\"\n",
    "        hoy = fecha_devolucion or date.today()\n",
    "        prestamo = self.prestamo_repo.find_by_codigo(codigo)\n",
    "        if prestamo is None:\n",
    "            raise ValueError('El préstamo no existe.')\n",
    "        if prestamo.estado == EstadoPrestamoEnum.DEVUELTO:\n",
    "            raise ValueError('El préstamo ya fue devuelto.')\n",
    "\n",
    "        prestamo.fecha_devolucion = hoy.strftime(FORMATO_FECHA)\n",
    "        prestamo.estado = EstadoPrestamoEnum.DEVUELTO\n",
    "        self.prestamo_repo.actualizar(prestamo)\n",
    "\n",
    "        libro = self.libro_repo.find_by_isbn(prestamo.isbn)\n",
    "        if libro is not None and libro.disponibles < libro.total_ejemplares:\n",
    "            libro.disponibles += 1\n",
    "            self.libro_repo.actualizar(libro)\n",
    "\n",
    "        limite = datetime.strptime(prestamo.fecha_limite, FORMATO_FECHA).date()\n",
    "        dias_retraso = max(0, (hoy - limite).days)\n",
    "        return prestamo, dias_retraso\n",
    "\n",
    "    def buscar_por_codigo(self, codigo):\n",
    "        \"\"\"Retorna el préstamo con ese código, o None.\"\"\"\n",
    "        return self.prestamo_repo.find_by_codigo(codigo)\n",
    "\n",
    "    def historial_usuario(self, num_documento):\n",
    "        \"\"\"Retorna los préstamos de un usuario en orden cronológico.\"\"\"\n",
    "        return sorted(self.prestamo_repo.find_by_usuario(num_documento),\n",
    "                      key=lambda p: p.fecha_prestamo)\n",
    "\n",
    "    def listar_vencidos(self, fecha=None):\n",
    "        \"\"\"Retorna los préstamos no devueltos cuya fecha límite es anterior a fecha.\"\"\"\n",
    "        ref = (fecha or date.today()).strftime(FORMATO_FECHA)\n",
    "        return [p for p in self.prestamo_repo.find_all()\n",
    "                if p.estado != EstadoPrestamoEnum.DEVUELTO and p.fecha_limite < ref]\n",
    "\n",
    "    def _tiene_multas_pendientes(self, num_documento):\n",
    "        \"\"\"Consulta multas pendientes del usuario (activo desde P3).\"\"\"\n",
    "        return bool(self.multa_repo.find_pendientes_usuario(num_documento))"
   ]
  },
