   "source": [
    "## Sección 3: servicios (lógica)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Celda 3.1: UsuarioService"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "class UsuarioService:\n",
    "    \"\"\"Reglas de negocio para la gestión de usuarios (RF-01).\"\"\"\n",
    "\n",
    "    def __init__(self, repo):\n",
    "        self.repo = repo\n",
    "\n",
    "    def registrar(self, num_documento, nombre, tipo, correo, telefono):\n",
    "        \"\"\"Registra un usuario nuevo. Lanza ValueError si el documento ya existe.\"\"\"\n",
    "        if self.repo.find_by_documento(num_documento):\n",
    "            raise ValueError('Ya existe un usuario con ese documento.')\n",
    "        u = Usuario(num_documento, nombre, tipo, correo, telefono)\n",
    "        self.repo.guardar(u)\n",
    "        return u\n",
    "\n",
    "    def buscar_por_documento(self, doc):\n",
    "        \"\"\"Retorna el usuario con ese documento, o None.\"\"\"\n",
    "        return self.repo.find_by_documento(doc)\n",
    "\n",
    "    def actualizar(self, doc, correo=None, telefono=None, estado=None):\n",
    "        \"\"\"Actualiza correo, teléfono o estado de un usuario existente.\"\"\"\n",
    "        u = self.repo.find_by_documento(doc)\n",
    "        if u is None:\n",
    "            raise ValueError('No existe un usuario con ese documento.')\n",
    "        if correo:\n",
    "            u.correo = correo\n",
    "        if telefono:\n",
    "            u.telefono = telefono\n",
    "        if estado:\n",
    "            u.estado = estado\n",
    "        self.repo.actualizar(u)\n",
    "        return u\n",
    "\n",
    "    def listar_todos(self):\n",
    "        \"\"\"Retorna todos los usuarios registrados.\"\"\"\n",
    "        return self.repo.find_all()"
