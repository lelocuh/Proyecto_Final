    "def _tabla_libros():\n",
    "    \"\"\"Tabla con todos los libros del catálogo.\"\"\"\n",
    "    return _tabla(libros_a_filas(libro_service.listar_todos()), H_LIBROS)\n",
    "\n",
    "\n",
    "def _tabla_categorias():\n",
    "    \"\"\"Tabla con todas las categorías.\"\"\"\n",
    "    return _tabla(categorias_a_filas(libro_service.listar_categorias()), H_CATEGORIAS)\n",
    "\n",
    "\n",
    "def ui_registrar_categoria(codigo, nombre, descripcion):\n",
    "    \"\"\"Registra una categoría desde el formulario.\"\"\"\n",
    "    try:\n",
    "        c = libro_service.registrar_categoria(_texto(codigo, 'código'), _texto(nombre, 'nombre'),\n",
    "                                              _texto(descripcion, 'descripción'))\n",
    "        return f'Categoría registrada: {c.codigo}.', _tabla_categorias()\n",
    "    except ValueError as e:\n",
    "        return f'Error: {e}', _tabla_categorias()\n",
    "\n",
    "\n",
    "def ui_registrar_libro(isbn, titulo, autor, cod_categoria, anio, total):\n",
    "    \"\"\"Registra un libro desde el formulario.\"\"\"\n",
    "    try:\n",
    "        anio_n = _entero(anio, 'año de publicación', 0)\n",
    "        if anio_n > date.today().year:\n",
    "            raise ValueError('El año de publicación no puede ser futuro.')\n",
    "        l = libro_service.registrar(_texto(isbn, 'ISBN'), _texto(titulo, 'título'),\n",
    "                                    _texto(autor, 'autor'), _texto(cod_categoria, 'categoría'),\n",
    "                                    anio_n, _entero(total, 'ejemplares', 1))\n",
    "        return f'Libro registrado: {l.titulo}.', _tabla_libros()\n",
    "    except ValueError as e:\n",
    "        return f'Error: {e}', _tabla_libros()\n",
    "\n",
    "\n",
    "def ui_buscar_isbn(texto):\n",
    "    \"\"\"Busca un libro por ISBN.\"\"\"\n",
    "    try:\n",
    "        l = libro_service.buscar_por_isbn(_texto(texto, 'búsqueda'))\n",
    "    except ValueError as e:\n",
    "        return f'Error: {e}', _tabla_libros()\n",
    "    if l is None:\n",
    "        return 'No se encontró el libro.', _tabla([], H_LIBROS)\n",
    "    return 'Libro encontrado.', libros_a_filas([l])\n",
    "\n",
    "\n",
    "def ui_buscar_titulo(texto):\n",
    "    \"\"\"Busca libros cuyo título contiene el texto.\"\"\"\n",
    "    try:\n",
    "        res = libro_service.buscar_por_titulo(_texto(texto, 'búsqueda'))\n",
    "    except ValueError as e:\n",
    "        return f'Error: {e}', _tabla_libros()\n",
    "    return f'{len(res)} resultado(s).', _tabla(libros_a_filas(res), H_LIBROS)\n",
    "\n",
    "\n",
    "def ui_buscar_categoria(texto):\n",
    "    \"\"\"Lista los libros de una categoría.\"\"\"\n",
    "    try:\n",
    "        res = libro_service.listar_por_categoria(_texto(texto, 'búsqueda'))\n",
    "    except ValueError as e:\n",
    "        return f'Error: {e}', _tabla_libros()\n",
    "    return f'{len(res)} resultado(s).', _tabla(libros_a_filas(res), H_LIBROS)\n",
    "\n",
    "\n",
    "def ui_listar_disponibles():\n",
    "    \"\"\"Lista los libros con ejemplares disponibles.\"\"\"\n",
    "    res = libro_service.listar_disponibles()\n",
    "    return f'{len(res)} libro(s) con ejemplares disponibles.', _tabla(libros_a_filas(res), H_LIBROS)\n",
    "\n",
    "\n",
    "def ui_listar_libros():\n",
    "    \"\"\"Lista todos los libros del catálogo.\"\"\"\n",
    "    return f'{len(libro_service.listar_todos())} libro(s) en el catálogo.', _tabla_libros()\n",
    "\n",
    "\n",
    "def ui_listar_categorias():\n",
    "    \"\"\"Lista todas las categorías.\"\"\"\n",
    "    return f'{len(libro_service.listar_categorias())} categoría(s).', _tabla_categorias()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Celda 4.3: funciones de la pestaña préstamos"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def ui_prestar(doc, isbn, fecha):\n",
    "    \"\"\"Registra un préstamo desde el formulario.\"\"\"\n",
    "    try:\n",
    "        p = prestamo_service.prestar(_texto(doc, 'documento'), _texto(isbn, 'ISBN'),\n",
    "                                     _fecha(fecha, 'Fecha de préstamo'))\n",
    "        return (f'Préstamo registrado: {p.codigo}. Fecha límite: {p.fecha_limite}.',\n",
    "                prestamos_a_filas([p]))\n",
    "    except ValueError as e:\n",
    "        return f'Error: {e}', _tabla([], H_PRESTAMOS)\n",
    "\n",
    "\n",
    "def ui_devolver(codigo, fecha):\n",
    "    \"\"\"Registra la devolución de un préstamo.\"\"\"\n",
    "    try:\n",
    "        p, retraso = prestamo_service.devolver(_texto(codigo, 'código'),\n",
    "                                               _fecha(fecha, 'Fecha de devolución'))\n",
    "        msg = f'Devolución registrada: {p.codigo}.'\n",
    "        if retraso > 0:\n",
    "            msg += f' Devuelto con {retraso} día(s) de retraso.'\n",
    "        return msg, prestamos_a_filas([p])\n",
    "    except ValueError as e:\n",
    "        return f'Error: {e}', _tabla([], H_PRESTAMOS)\n",
    "\n",
    "\n",
    "def ui_consultar_prestamo(codigo):\n",
    "    \"\"\"Consulta un préstamo por código.\"\"\"\n",
    "    try:\n",
    "        p = prestamo_service.buscar_por_codigo(_texto(codigo, 'código'))\n",
    "    except ValueError as e:\n",
    "        return f'Error: {e}', _tabla([], H_PRESTAMOS)\n",
    "    if p is None:\n",
    "        return 'No se encontró el préstamo.', _tabla([], H_PRESTAMOS)\n",
    "    return 'Préstamo encontrado.', prestamos_a_filas([p])\n",
    "\n",
    "\n",
    "def ui_historial(doc):\n",
    "    \"\"\"Lista los préstamos de un usuario en orden cronológico.\"\"\"\n",
    "    try:\n",
    "        res = prestamo_service.historial_usuario(_texto(doc, 'documento'))\n",
    "    except ValueError as e:\n",
    "        return f'Error: {e}', _tabla([], H_PRESTAMOS)\n",
    "    return f'{len(res)} préstamo(s) del usuario.', _tabla(prestamos_a_filas(res), H_PRESTAMOS)\n",
    "\n",
    "\n",
    "def ui_vencidos(fecha):\n",
    "    \"\"\"Lista los préstamos vencidos a una fecha de corte.\"\"\"\n",
    "    try:\n",
    "        res = prestamo_service.listar_vencidos(_fecha(fecha, 'Fecha de corte'))\n",
    "    except ValueError as e:\n",
    "        return f'Error: {e}', _tabla([], H_PRESTAMOS)\n",
    "    return f'{len(res)} préstamo(s) vencido(s).', _tabla(prestamos_a_filas(res), H_PRESTAMOS)"
   ]
  },
