   "source": [
    "def construir_interfaz():\n",
    "    \"\"\"Arma la interfaz de Gradio con una pestaña por módulo.\"\"\"\n",
    "    with gr.Blocks(title='Sistema de Gestión de Biblioteca', theme=gr.themes.Soft()) as demo:\n",
    "        gr.Markdown('# Sistema de Gestión de Biblioteca')\n",
    "\n",
    "        # ---------------- usuarios ----------------\n",
    "        with gr.Tab('Usuarios'):\n",
    "            with gr.Row():\n",
    "                with gr.Column():\n",
    "                    gr.Markdown('### Registrar usuario')\n",
    "                    u_doc = gr.Textbox(label='Número de documento')\n",
    "                    u_nombre = gr.Textbox(label='Nombre completo')\n",
    "                    u_tipo = gr.Dropdown(choices=[t.value for t in TipoUsuarioEnum],\n",
    "                                         value=TipoUsuarioEnum.ESTUDIANTE.value,\n",
    "                                         label='Tipo de usuario')\n",
    "                    u_correo = gr.Textbox(label='Correo')\n",
    "                    u_tel = gr.Textbox(label='Teléfono')\n",
    "                    u_reg = gr.Button('Registrar', variant='primary')\n",
    "                with gr.Column():\n",
    "                    gr.Markdown('### Consultar o actualizar')\n",
    "                    u_doc2 = gr.Textbox(label='Documento del usuario')\n",
    "                    u_correo2 = gr.Textbox(label='Nuevo correo (vacío para no cambiar)')\n",
    "                    u_tel2 = gr.Textbox(label='Nuevo teléfono (vacío para no cambiar)')\n",
    "                    u_estado = gr.Dropdown(choices=['Sin cambio', ESTADO_USUARIO_ACTIVO,\n",
    "                                                    ESTADO_USUARIO_SUSPENDIDO],\n",
    "                                           value='Sin cambio', label='Estado')\n",
    "                    with gr.Row():\n",
    "                        u_cons = gr.Button('Consultar')\n",
    "                        u_act = gr.Button('Actualizar', variant='primary')\n",
    "                    u_list = gr.Button('Listar todos')\n",
    "            u_msg = gr.Markdown()\n",
    "            u_tabla = gr.Dataframe(headers=H_USUARIOS, value=_tabla_usuarios(),\n",
    "                                   interactive=False, label='Usuarios')\n",
    "            u_reg.click(ui_registrar_usuario, [u_doc, u_nombre, u_tipo, u_correo, u_tel],\n",
    "                        [u_msg, u_tabla])\n",
    "            u_cons.click(ui_consultar_usuario, [u_doc2], [u_msg, u_tabla])\n",
    "            u_act.click(ui_actualizar_usuario, [u_doc2, u_correo2, u_tel2, u_estado],\n",
    "                        [u_msg, u_tabla])\n",
    "            u_list.click(ui_listar_usuarios, None, [u_msg, u_tabla])\n",
    "\n",
    "        # ---------------- libros y categorías ----------------\n",
    "        with gr.Tab('Libros y categorías'):\n",
    "            with gr.Row():\n",
    "                with gr.Column():\n",
    "                    gr.Markdown('### Registrar categoría')\n",
    "                    c_cod = gr.Textbox(label='Código de categoría')\n",
    "                    c_nom = gr.Textbox(label='Nombre')\n",
    "                    c_desc = gr.Textbox(label='Descripción')\n",
    "                    c_reg = gr.Button('Registrar categoría', variant='primary')\n",
    "                    c_list = gr.Button('Listar categorías')\n",
    "                with gr.Column():\n",
    "                    gr.Markdown('### Registrar libro')\n",
    "                    l_isbn = gr.Textbox(label='ISBN')\n",
    "                    l_titulo = gr.Textbox(label='Título')\n",
    "                    l_autor = gr.Textbox(label='Autor')\n",
    "                    l_cat = gr.Textbox(label='Código de categoría')\n",
    "                    l_anio = gr.Number(label='Año de publicación', precision=0)\n",
    "                    l_total = gr.Number(label='Número de ejemplares', value=1, precision=0)\n",
    "                    l_reg = gr.Button('Registrar libro', variant='primary')\n",
    "            gr.Markdown('### Consultar libros')\n",
    "            l_busca = gr.Textbox(label='Texto de búsqueda (ISBN, título o código de categoría)')\n",
    "            with gr.Row():\n",
    "                l_b_isbn = gr.Button('Buscar por ISBN')\n",
    "                l_b_tit = gr.Button('Buscar por título')\n",
    "                l_b_cat = gr.Button('Buscar por categoría')\n",
    "                l_disp = gr.Button('Listar con ejemplares disponibles')\n",
    "                l_todos = gr.Button('Listar todos')\n",
    "            l_msg = gr.Markdown()\n",
    "            l_tabla = gr.Dataframe(headers=H_LIBROS, value=_tabla_libros(),\n",
    "                                   interactive=False, label='Libros')\n",
    "            cat_tabla = gr.Dataframe(headers=H_CATEGORIAS, value=_tabla_categorias(),\n",
    "                                     interactive=False, label='Categorías')\n",
    "            c_reg.click(ui_registrar_categoria, [c_cod, c_nom, c_desc], [l_msg, cat_tabla])\n",
    "            c_list.click(ui_listar_categorias, None, [l_msg, cat_tabla])\n",
    "            l_reg.click(ui_registrar_libro, [l_isbn, l_titulo, l_autor, l_cat, l_anio, l_total],\n",
    "                        [l_msg, l_tabla])\n",
    "            l_b_isbn.click(ui_buscar_isbn, [l_busca], [l_msg, l_tabla])\n",
    "            l_b_tit.click(ui_buscar_titulo, [l_busca], [l_msg, l_tabla])\n",
    "            l_b_cat.click(ui_buscar_categoria, [l_busca], [l_msg, l_tabla])\n",
    "            l_disp.click(ui_listar_disponibles, None, [l_msg, l_tabla])\n",
    "            l_todos.click(ui_listar_libros, None, [l_msg, l_tabla])\n",
    "\n",
    "        # ---------------- préstamos ----------------\n",
    "        with gr.Tab('Préstamos'):\n",
    "            with gr.Row():\n",
    "                with gr.Column():\n",
    "                    gr.Markdown('### Prestar libro')\n",
    "                    p_doc = gr.Textbox(label='Documento del usuario')\n",
    "                    p_isbn = gr.Textbox(label='ISBN del libro')\n",
    "                    p_fecha = gr.Textbox(label='Fecha del préstamo (AAAA-MM-DD, vacío = hoy)')\n",
    "                    p_prestar = gr.Button('Prestar', variant='primary')\n",
    "                with gr.Column():\n",
    "                    gr.Markdown('### Devolver libro')\n",
    "                    d_cod = gr.Textbox(label='Código del préstamo')\n",
    "                    d_fecha = gr.Textbox(label='Fecha de devolución (AAAA-MM-DD, vacío = hoy)')\n",
    "                    d_devolver = gr.Button('Devolver', variant='primary')\n",
    "            gr.Markdown('### Consultas')\n",
    "            with gr.Row():\n",
    "                q_cod = gr.Textbox(label='Código del préstamo')\n",
    "                q_doc = gr.Textbox(label='Documento del usuario')\n",
    "                q_corte = gr.Textbox(label='Fecha de corte (AAAA-MM-DD, vacío = hoy)')\n",
    "            with gr.Row():\n",
    "                q_b_cod = gr.Button('Consultar por código')\n",
    "                q_b_hist = gr.Button('Historial del usuario')\n",
    "                q_b_venc = gr.Button('Listar vencidos')\n",
    "            p_msg = gr.Markdown()\n",
    "            p_tabla = gr.Dataframe(headers=H_PRESTAMOS, value=_tabla([], H_PRESTAMOS),\n",
    "                                   interactive=False, label='Préstamos')\n",
    "            p_prestar.click(ui_prestar, [p_doc, p_isbn, p_fecha], [p_msg, p_tabla])\n",
    "            d_devolver.click(ui_devolver, [d_cod, d_fecha], [p_msg, p_tabla])\n",
    "            q_b_cod.click(ui_consultar_prestamo, [q_cod], [p_msg, p_tabla])\n",
    "            q_b_hist.click(ui_historial, [q_doc], [p_msg, p_tabla])\n",
    "            q_b_venc.click(ui_vencidos, [q_corte], [p_msg, p_tabla])\n",
    "\n",
    "        # ---------------- pendientes ----------------\n",
    "        with gr.Tab('Reservas y multas'):\n",
    "            gr.Markdown('Pendiente: se implementa en el prototipo P3.')\n",
    "        with gr.Tab('Análisis de datos'):\n",
    "            gr.Markdown('Pendiente: se implementa en el prototipo P4.')\n",
    "    return demo"
   ]
  },
