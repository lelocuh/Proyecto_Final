   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Celda 1.1: enums"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "from enum import Enum\n",
    "\n",
    "\n",
    "class TipoUsuarioEnum(Enum):\n",
    "    \"\"\"Tipos de usuario de la biblioteca.\"\"\"\n",
    "    ESTUDIANTE = 'ESTUDIANTE'\n",
    "    DOCENTE = 'DOCENTE'\n",
    "    EXTERNO = 'EXTERNO'\n",
    "\n",
    "\n",
    "class EstadoPrestamoEnum(Enum):\n",
    "    \"\"\"Estados posibles de un préstamo.\"\"\"\n",
    "    ACTIVO = 'ACTIVO'\n",
    "    DEVUELTO = 'DEVUELTO'\n",
    "    VENCIDO = 'VENCIDO'\n",
    "\n",
    "\n",
    "class EstadoMultaEnum(Enum):\n",
    "    \"\"\"Estados posibles de una multa.\"\"\"\n",
    "    PENDIENTE = 'PENDIENTE'\n",
    "    PAGADA = 'PAGADA'\n",
    "\n",
    "\n",
    "class EstadoReservaEnum(Enum):\n",
    "    \"\"\"Estados posibles de una reserva.\"\"\"\n",
    "    ACTIVA = 'ACTIVA'\n",
    "    CUMPLIDA = 'CUMPLIDA'\n",
    "    CANCELADA = 'CANCELADA'\n",
    "\n",
    "\n",
    "# Reglas por tipo de usuario (RF-03): días de préstamo y cupo de libros\n",
    "DIAS_PRESTAMO = {\n",
    "    TipoUsuarioEnum.ESTUDIANTE: 7,\n",
    "    TipoUsuarioEnum.DOCENTE: 15,\n",
    "    TipoUsuarioEnum.EXTERNO: 5,\n",
    "}\n",
    "CUPO_LIBROS = {\n",
    "    TipoUsuarioEnum.ESTUDIANTE: 3,\n",
    "    TipoUsuarioEnum.DOCENTE: 5,\n",
    "    TipoUsuarioEnum.EXTERNO: 2,\n",
    "}\n",
    "ESTADO_USUARIO_ACTIVO = 'ACTIVO'\n",
    "ESTADO_USUARIO_SUSPENDIDO = \"SUSPENDIDO\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Celda 1.2: clase Usuario"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "class Usuario:\n",
    "    \"\"\"Persona registrada en la biblioteca.\"\"\"\n",
    "\n",
    "    def __init__(self, num_documento, nombre, tipo, correo, telefono,\n",
    "                 estado=ESTADO_USUARIO_ACTIVO):\n",
    "        self.num_documento = num_documento\n",
    "        self.nombre = nombre\n",
    "        self.tipo = tipo            # TipoUsuarioEnum\n",
    "        self.correo = correo\n",
    "        self.telefono = telefono\n",
    "        self.estado = estado        # 'ACTIVO' o 'SUSPENDIDO'\n",
    "\n",
    "    def to_linea(self):\n",
    "        \"\"\"Convierte el usuario a una línea de texto delimitada por |.\"\"\"\n",
    "        return '|'.join([self.num_documento, self.nombre, self.tipo.value,\n",
    "                         self.correo, self.telefono, self.estado])\n",
    "\n",
    "    @staticmethod\n",
    "    def from_linea(linea):\n",
    "        \"\"\"Construye un Usuario a partir de una línea de usuarios.txt.\"\"\"\n",
    "        c = linea.split('|')\n",
    "        return Usuario(c[0], c[1], TipoUsuarioEnum(c[2]), c[3], c[4], c[5])\n",
    "\n",
    "    def __str__(self):\n",
    "        return (f'{self.num_documento} | {self.nombre} | {self.tipo.value} | '\n",
    "                f'{self.correo} | {self.telefono} | {self.estado}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Celda 1.3: clase Categoria"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "class Categoria:\n",
    "    \"\"\"Categoría temática que agrupa libros.\"\"\"\n",
    "\n",
    "    def __init__(self, codigo, nombre, descripcion):\n",
    "        self.codigo = codigo\n",
    "        self.nombre = nombre\n",
    "        self.descripcion = descripcion\n",
    "\n",
    "    def to_linea(self):\n",
    "        \"\"\"Convierte la categoría a una línea delimitada por |.\"\"\"\n",
    "        return '|'.join([self.codigo, self.nombre, self.descripcion])\n",
    "\n",
    "    @staticmethod\n",
    "    def from_linea(linea):\n",
    "        \"\"\"Construye una Categoria a partir de una línea de categorias.txt.\"\"\"\n",
    "        c = linea.split('|')\n",
    "        return Categoria(c[0], c[1], c[2])\n",
    "\n",
    "    def __str__(self):\n",
    "        return f\"{self.codigo} | {self.nombre} | {self.descripcion}\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Celda 1.4: clase Libro"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "class Libro:\n",
    "    \"\"\"Libro del catálogo con control de ejemplares.\"\"\"\n",
    "\n",
    "    def __init__(self, isbn, titulo, autor, cod_categoria, anio,\n",
    "                 total_ejemplares, disponibles):\n",
    "        self.isbn = isbn\n",
    "        self.titulo = titulo\n",
    "        self.autor = autor\n",
    "        self.cod_categoria = cod_categoria\n",
    "        self.anio = anio                          # int\n",
    "        self.total_ejemplares = total_ejemplares  # int\n",
    "        self.disponibles = disponibles            # int\n",
    "\n",
    "    def to_linea(self):\n",
    "        \"\"\"Convierte el libro a una línea delimitada por |.\"\"\"\n",
    "        return '|'.join([self.isbn, self.titulo, self.autor, self.cod_categoria,\n",
    "                         str(self.anio), str(self.total_ejemplares),\n",
    "                         str(self.disponibles)])\n",
    "\n",
    "    @staticmethod\n",
    "    def from_linea(linea):\n",
    "        \"\"\"Construye un Libro a partir de una línea de libros.txt.\"\"\"\n",
    "        c = linea.split('|')\n",
    "        return Libro(c[0], c[1], c[2], c[3], int(c[4]), int(c[5]), int(c[6]))\n",
    "\n",
    "    def __str__(self):\n",
    "        return (f'{self.isbn} | {self.titulo} | {self.autor} | cat: {self.cod_categoria} | '\n",
    "                f'{self.anio} | disponibles: {self.disponibles}/{self.total_ejemplares}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Celda 1.5: clase Prestamo"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "class Prestamo:\n",
    "    \"\"\"Préstamo de un libro a un usuario.\"\"\"\n",
    "\n",
    "    def __init__(self, codigo, isbn, num_documento, fecha_prestamo, fecha_limite,\n",
    "                 fecha_devolucion=NINGUNO, estado=EstadoPrestamoEnum.ACTIVO):\n",
    "        self.codigo = codigo\n",
    "        self.isbn = isbn\n",
    "        self.num_documento = num_documento\n",
    "        self.fecha_prestamo = fecha_prestamo      # texto AAAA-MM-DD\n",
    "        self.fecha_limite = fecha_limite          # texto AAAA-MM-DD\n",
    "        self.fecha_devolucion = fecha_devolucion  # texto AAAA-MM-DD o NINGUNO\n",
    "        self.estado = estado                      # EstadoPrestamoEnum\n",
    "\n",
    "    def to_linea(self):\n",
    "        \"\"\"Convierte el préstamo a una línea delimitada por |.\"\"\"\n",
    "        return '|'.join([self.codigo, self.isbn, self.num_documento,\n",
    "                         self.fecha_prestamo, self.fecha_limite,\n",
    "                         self.fecha_devolucion, self.estado.value])\n",
    "\n",
    "    @staticmethod\n",
    "    def from_linea(linea):\n",
    "        \"\"\"Construye un Prestamo a partir de una línea de prestamos.txt.\"\"\"\n",
    "        c = linea.split('|')\n",
    "        return Prestamo(c[0], c[1], c[2], c[3], c[4], c[5], EstadoPrestamoEnum(c[6]))\n",
    "\n",
    "    def __str__(self):\n",
    "        return (f'{self.codigo} | libro {self.isbn} | usuario {self.num_documento} | '\n",
    "                f'prestado {self.fecha_prestamo} | límite {self.fecha_limite} | '\n",
    "                f'devuelto {self.fecha_devolucion} | {self.estado.value}')"
   ]
  },
