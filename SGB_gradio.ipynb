    "    except ValueError as e:\n",
    "        return f'Error: {e}', _tabla_usuarios()\n",
    "\n",
    "\n",
    "def ui_consultar_usuario(doc):\n",
    "    \"\"\"Consulta un usuario por documento.\"\"\"\n",
    "    try:\n",
