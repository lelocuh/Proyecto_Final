    "    try:\n",
    "        estado_nuevo = None if estado == 'Sin cambio' else estado\n",
    "        u = usuario_service.actualizar(_texto(doc, 'documento'),\n",
    "                                       _texto_opcional(correo, 'correo'),\n",
    "                                       _texto_opcional(telefono, 'teléfono'),\n",
    "                                       estado_nuevo)\n",
    "        return f'Usuario actualizado: {u.nombre}.', usuarios_a_filas([u])\n",
    "    except ValueError as e:\n",
    "        return f'Error: {e}', _tabla_usuarios()\n",
    "\n",
    "\n",
    "def ui_listar_usuarios():\n",
    "    \"\"\"Lista todos los usuarios.\"\"\"\n",
    "    return f'{len(usuario_service.listar_todos())} usuario(s) registrado(s).', _tabla_usuarios()"
