    "        return f'Error: {e}', _tabla_usuarios()\n",
    "    if u is None:\n",
    "        return 'No se encontró el usuario.', _tabla([], H_USUARIOS)\n",
    "    return 'Usuario encontrado.', usuarios_a_filas([u])\n",
    "\n",
    "\n",
